# Execution
WORKFORCE_MAX_REVISIONS=1
WORKFORCE_AGENT_TIMEOUT_SECONDS=60
WORKFORCE_PERSISTENCE_ENABLED=true
WORKFORCE_MAX_TASK_LENGTH=4000

# Live LLM (LiteLLM). Never commit real keys.
WORKFORCE_LLM_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
# Or other provider keys matching your model id, e.g. ANTHROPIC_API_KEY=

# Optional live search (Firecrawl). Leave empty for unverified model-knowledge research.
FIRECRAWL_API_KEY=
