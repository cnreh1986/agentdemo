# Streamlit secrets template (TOML).
# Local: copy to .streamlit/secrets.toml (gitignored) and fill in real values.
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# Community Cloud: App → Settings → Secrets — paste the same TOML (with your keys).
#
# Never commit real API keys. Demo Mode works with empty values.

# Live LLM (LiteLLM)
OPENAI_API_KEY = ""
# ANTHROPIC_API_KEY = ""
WORKFORCE_LLM_MODEL = "openai/gpt-4o-mini"

# Optional live web research (Firecrawl)
FIRECRAWL_API_KEY = ""

# Live job search (SerpAPI Google Jobs) — required for Live Mode job_search tasks
SERPAPI_API_KEY = ""

# Workshop execution knobs (strings are fine in Streamlit secrets)
WORKFORCE_PERSISTENCE_ENABLED = "true"
WORKFORCE_MAX_REVISIONS = "1"
WORKFORCE_AGENT_TIMEOUT_SECONDS = "60"
WORKFORCE_MAX_TASK_LENGTH = "4000"
